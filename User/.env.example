# User Standalone Application Configuration
# Port: Defaults to 5174
PORT=5174

# API Base URL for Load Balancer:
# Defaults to relative '/api' (proxied by Vite to port 3000), or fallback to host port 3000
VITE_API_URL="/api"

# URL of the Load Balancer Management Portal
VITE_LB_PORTAL_URL="http://localhost:3000"
